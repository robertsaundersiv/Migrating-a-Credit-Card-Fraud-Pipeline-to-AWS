# Copy to .env and fill in. Never commit .env.
# Fill in the credentials only in .env, never in this example file.

AWS_REGION=us-east-1
# AWS_PROFILE=default

# Local development only (e.g. temporary lab credentials). In AWS, leave these
# out: the ECS task role supplies credentials. The session token is only needed
# for temporary credentials (keys starting with ASIA).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Cloud storage location of the trained model (written by the Glue job)
MODEL_S3_BUCKET=your-model-bucket
MODEL_S3_PREFIX=models/fraud_detection_model_latest

# Intermediate storage: where the model is downloaded before Spark loads it
LOCAL_MODEL_PATH=/tmp/fraud_detection_model_latest
